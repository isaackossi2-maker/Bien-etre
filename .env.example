# Copiez ce fichier en ".env" (jamais suivi par git) et remplissez les valeurs réelles.

# Mot de passe du serveur TURN auto-hébergé (coturn), partagé entre le conteneur coturn et le
# bundle frontend (voir docker-compose.yml et frontend/src/call/CallContext.tsx).
# Générez-en un nouveau avec : openssl rand -hex 16
TURN_PASSWORD=

# IP publique de la machine qui héberge coturn (optionnel, sinon calculé automatiquement côté
# navigateur). Nécessaire quand l'app est ouverte via le tunnel Cloudflare.
# TURN_HOST=

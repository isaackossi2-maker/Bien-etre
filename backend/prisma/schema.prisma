generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum QuestionType {
  SINGLE
  MULTIPLE
}

enum MessageType {
  TEXT
  AUDIO
  FILE
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  name            String
  avatar          String?
  role            Role             @default(USER)
  createdAt       DateTime         @default(now())
  examResults     ExamResult[]
  logs            Log[]
  sentMessages    Message[]        @relation("MessageSender")
  receivedMessages Message[]       @relation("MessageRecipient")
  posts           Post[]
  postReactions   PostReaction[]
  postComments    PostComment[]
  postRecipient   PostRecipient[]
  meditationViews MeditationView[]
  createdGroups    Group[]        @relation("GroupCreator")
  groupMemberships GroupMember[]
  groupMessages    GroupMessage[] @relation("GroupMessageSender")
  createdMeetings  Meeting[]      @relation("MeetingCreator")
  meetingJoins     MeetingParticipant[]
}

model Exam {
  id          String       @id @default(uuid())
  title       String
  description String?
  isActive    Boolean      @default(true)
  duration    Int?
  maxAttempts Int?
  createdAt   DateTime     @default(now())
  questions   Question[]
  results     ExamResult[]
}

model Question {
  id             String          @id @default(uuid())
  text           String
  type           QuestionType    @default(SINGLE)
  order          Int             @default(0)
  examId         String
  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers        Answer[]
  userAnswers    UserAnswer[]
  questionGrades QuestionGrade[]
  createdAt      DateTime        @default(now())
}

model Answer {
  id          String       @id @default(uuid())
  text        String
  isCorrect   Boolean      @default(false)
  questionId  String
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswers UserAnswer[]
}

model Meditation {
  id          String           @id @default(uuid())
  title       String
  description String?
  content     String?
  duration    Int?
  createdAt   DateTime         @default(now())
  views       MeditationView[]
}

model MeditationView {
  id           String     @id @default(uuid())
  meditationId String
  meditation   Meditation @relation(fields: [meditationId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt     DateTime   @default(now())

  @@unique([meditationId, userId])
}

model Message {
  id                     String      @id @default(uuid())
  senderId               String
  sender                 User        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId            String
  recipient              User        @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type                   MessageType @default(TEXT)
  content                String?
  audioData              String?
  audioDuration          Int?
  fileData               String?
  fileName               String?
  fileMimeType           String?
  readAt                 DateTime?
  createdAt              DateTime    @default(now())
  examResultNotification ExamResult?
}

model Post {
  id         String          @id @default(uuid())
  authorId   String
  author     User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  background String?
  createdAt  DateTime        @default(now())
  reactions  PostReaction[]
  comments   PostComment[]
  recipients PostRecipient[]
}

// Un post sans destinataire (recipients vide) est public, visible par tout le monde.
model PostRecipient {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostReaction {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String   @default("👍")
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model ExamResult {
  id                     String          @id @default(uuid())
  userId                 String
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId                 String
  exam                   Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  score                  Int
  total                  Int
  comment                String?
  createdAt              DateTime        @default(now())
  userAnswers            UserAnswer[]
  questionGrades         QuestionGrade[]
  notificationMessageId  String?         @unique
  notificationMessage    Message?        @relation(fields: [notificationMessageId], references: [id], onDelete: SetNull)
}

model QuestionGrade {
  id           String     @id @default(uuid())
  examResultId String
  examResult   ExamResult @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  isCorrect    Boolean

  @@unique([examResultId, questionId])
}

model UserAnswer {
  id           String     @id @default(uuid())
  examResultId String
  examResult   ExamResult @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerId     String
  answer       Answer     @relation(fields: [answerId], references: [id], onDelete: Cascade)
}

model Group {
  id          String         @id @default(uuid())
  name        String
  avatar      String?
  createdById String
  createdBy   User           @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  members     GroupMember[]
  messages    GroupMessage[]
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
}

model GroupMessage {
  id            String      @id @default(uuid())
  groupId       String
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation("GroupMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  type          MessageType @default(TEXT)
  content       String?
  audioData     String?
  audioDuration Int?
  fileData      String?
  fileName      String?
  fileMimeType  String?
  createdAt     DateTime    @default(now())
}

// Réunion ad-hoc partageable par lien : n'importe quel utilisateur connecté
// disposant du lien peut la rejoindre (pas de liste de membres comme Group).
model Meeting {
  id           String               @id @default(uuid())
  title        String
  createdById  String
  createdBy    User                 @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  endedAt      DateTime?
  participants MeetingParticipant[]
}

// Trace de passage : qui a effectivement rejoint quelle réunion, pour pouvoir
// distinguer les réunions manquées (terminées, jamais rejointes) des autres.
model MeetingParticipant {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([meetingId, userId])
}

// Cache des traductions à la volée (LibreTranslate) : évite de re-traduire un
// même texte à chaque affichage. Clé = hash du texte source + langue cible.
model TranslationCache {
  id             String   @id @default(uuid())
  sourceHash     String
  targetLang     String
  translatedText String   @db.Text
  createdAt      DateTime @default(now())

  @@unique([sourceHash, targetLang])
}

// Livre/document PDF affiché sur la page Bible (bibliothèque gérée par l'admin). La
// couverture est stockée en base64 (petite image, cohérent avec le reste de l'appli) mais
// le PDF lui-même est stocké sur disque (fileFileName), pas en base : les documents peuvent
// être volumineux (livres scannés), contrairement aux images/messages déjà en base64.
model Document {
  id               String    @id @default(uuid())
  title            String
  description      String?
  coverData        String    @db.Text
  fileFileName     String
  originalFileName String
  fileMimeType     String
  fileSize         Int
  // Le téléchargement (par opposition à la simple visualisation en ligne) est désactivé par
  // défaut et doit être explicitement autorisé par l'admin, avec une fenêtre de dates
  // optionnelle : bornes nulles = pas de restriction de ce côté (voir routes/documents.ts).
  downloadEnabled  Boolean   @default(false)
  downloadStartAt  DateTime?
  downloadEndAt    DateTime?
  createdAt        DateTime  @default(now())
}

// Verset du jour affiché sur les pages Méditations (admin + utilisateur) : une seule ligne
// partagée par toute l'application (id fixe "current"), qui se renouvelle automatiquement
// toutes les 24h sauf si l'admin l'a personnalisé (voir routes/meditations.ts).
model DailyVerse {
  id              String   @id @default("current")
  isCustom        Boolean  @default(false)
  textFr          String?  @db.Text
  textEn          String?  @db.Text
  referenceFr     String?
  referenceEn     String?
  customText      String?  @db.Text
  customReference String?
  updatedAt       DateTime @default(now()) @updatedAt
}

model Log {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  message   String?
  createdAt DateTime @default(now())
}
